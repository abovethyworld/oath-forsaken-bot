  "rules": {
    "banner": "https://cdn.discordapp.com/attachments/1558458301627506788/1558490947933966517/banner-rules.png?ex=6acba14d&is=6aca4fcd&hm=a969f785daa5c2a68b09be6684bd64e049c7f876ffd11be7e7d4b5efbb0f4c50&",
    "color": 7015950,
    "footer": "Staff enforce the rules. If you are not sure about something just ask a mod.\nSee <#1558481986706870445> for the rank ladders.",
    "intro": "\u26e7 *Chaos takes all.* \u26e7\nThe weak fear chaos. We swear by it. Every member takes one oath: get stronger, never bend, let chaos take the rest.\n\nIf you are in this server you agree to the rules below.",
    "sections": [
      {
        "heading": "1. Be respectful",
        "body": "Don't be a jerk. No harassment, no hate speech, no drama. Banter is fine."
      },
      {
        "heading": "2. No scamming",
        "body": "Scam a clanmate and you are banned. No second chances."
      },
      {
        "heading": "3. Keep it SFW",
        "body": "Keep public channels clean. Keep it classy."
      },
      {
        "heading": "4. No spam or ads",
        "body": "No spam. Don't advertise other servers unless staff says it is ok."
      },
      {
        "heading": "5. Iron first clan",
        "body": "This is an ironman clan. Mains are welcome in the Discord, you earn seniority ranks and you can join casual stuff like skilling events and weekly PvM nights. But bingos and WOM comps are ironmen only."
      },
      {
        "heading": "6. No begging",
        "body": "Don't ask clanmates for handouts, items or GP."
      },
      {
        "heading": "7. No poaching",
        "body": "Don't try to recruit our members to other clans."
      },
      {
        "heading": "8. Pvm etiquette",
        "body": "We are an FFA clan. You keep your own drops. If your group wants to split instead, agree on it before you go. Bring screenshots if there is a dispute."
      },
      {
        "heading": "9. Discord name matches RSN",
        "body": "Match your Discord name to your RSN so we know who is who. Ask staff if you need help."
      },
      {
        "heading": "10. Alt accounts",
        "body": "Alts are welcome but they earn ranks on their own like everyone else."
      },
      {
        "heading": "11. Be an adult",
        "body": "Handle your own disputes first like an adult. Staff are the last resort, not the first stop."
      },
      {
        "heading": "12. Stay active",
        "body": "Gone a long time with no word and you might get removed from the clan."
      }
    ],
    "title": "RULES"
  },
  "strikeSystem": {
    "banner": "https://cdn.discordapp.com/attachments/1558458301627506788/1558488067495436458/banner-strikes.png?ex=6acb9e9e&is=6aca4d1e&hm=22203a0ee198e9c28ae672d2952e12330e61803d754a4ed028dd70fb13f5ea5f&",
    "color": 7015950,
    "footer": "Strikes go away after 90 days of good behavior. Staff decisions are final. Got an issue, bring it up in private, not in public channels.",
    "intro": "Staff keep track of strikes. 3 strikes and you are out.",
    "levels": [
      {
        "heading": "Strike 1: verbal warning",
        "body": "Staff DMs you about what went wrong."
      },
      {
        "heading": "Strike 2: muted 24 hours",
        "body": "Last chance to shape up."
      },
      {
        "heading": "Strike 3: banned",
        "body": "Removed from the server and the in-game clan."
      },
      {
        "heading": "Immediate ban, no strikes",
        "body": "Hate speech, doxxing, or scamming gets you banned on the spot. No warnings."
      }
    ],
    "title": "STRIKE SYSTEM"
  },
