  "rules": {
    "banner": "https://lh3.googleusercontent.com/d/1TI29g6w1TEaU2NLdfmN4-GkdGIbsFL6R",
    "color": 7015950,
    "footer": "Our staff team enforces these rules to keep Oath Forsaken a great place to be. Questions? Open a ticket in <#1558399103757717518>.\nSee <#1558481986706870445> for rank information and <#1558399101454786670> to set up your notifications.",
    "intro": "\u26e7 *Chaos takes all.* \u26e7\nThe weak fear chaos. We swear by it. Every member takes one oath: get stronger, never bend, let chaos take the rest.\n\n**New here?**\n1. Pick your application in <#1558905814482423818>\n2. Once approved, you'll unlock the rest of the server. Grab your roles in <#1558399101454786670>\n\n**TL;DR:** Be respectful. Ironman-centric clan. FFA loot.\n\nIf you are in this server you agree to the rules below.",
    "sections": [
      {
        "heading": "\u26e7 Be respectful",
        "body": "We're here to have fun together. Treat everyone with respect. No harassment, hate speech, or drama. Don't ask others for items or GP. Don't crash others or PK clanmates. Friendly banter is always welcome."
      },
      {
        "heading": "\u26e7 LGBTQ+ friendly",
        "body": "We're LGBTQ+ friendly. Whoever you are, you belong here. Discrimination isn't tolerated."
      },
      {
        "heading": "\u26e7 No scamming",
        "body": "Trust matters here. Scamming a fellow clanmate will result in a permanent ban and a report to RuneWatch. If you lend items, do so at your own risk and always use collateral."
      },
      {
        "heading": "\u26e7 Keep it clean",
        "body": "Keep public channels safe for work so everyone feels comfortable here."
      },
      {
        "heading": "\u26e7 No spam or advertising",
        "body": "Don't spam or advertise other servers without checking with staff first."
      },
      {
        "heading": "\u26e7 Ironman-centric",
        "body": "Oath Forsaken is an ironman-centric clan. Mains are welcome too. Earn seniority, join events, game nights, group PvM and skilling. Be part of the clan. Alts are welcome and earn ranks independently. Our team events and weekly skilling, raiding, and bossing competitions are designed for ironmen."
      },
      {
        "heading": "\u26e7 No poaching",
        "body": "Don't recruit our members to other clans."
      },
      {
        "heading": "\u26e7 PvM etiquette",
        "body": "We're an FFA clan, so your drops are yours to keep. If your group would prefer to split, agree on it before you head out. Screenshots help resolve any disputes."
      },
      {
        "heading": "\u26e7 Match your RSN",
        "body": "Set your Discord nickname to match your RuneScape name so we know who's who. Staff are happy to help if you need it."
      },
      {
        "heading": "\u26e7 Handle disputes maturely",
        "body": "If something comes up, try to work it out directly first. Staff are here if you need them, but they're the last resort."
      },
      {
        "heading": "\u26e7 Stay active",
        "body": "After 90 days of no gains and no Discord activity without notifying staff, you may be removed from the CC and Discord. Doesn't apply to alts.\n\nIf you join but don't apply within 7 days, you'll be removed from the server."
      },
      {
        "heading": "\u26e7 Keep chat comfortable",
        "body": "Avoid spoilers for games, shows, books, or movies. Political discussions stay out of the server to keep things relaxed for everyone."
      },
      {
        "heading": "\u26e7 Jagex rules apply",
        "body": "All of Jagex's rules apply here as well."
      }
    ],
    "title": "\u26e7 Rules \u26e7"
  },
  "strikeSystem": {
    "banner": "https://lh3.googleusercontent.com/d/1hSDNxaZHmS1H3kBrGjsuLLeJT4u7eAuH",
    "color": 7015950,
    "footer": "Strikes expire after 90 days of good behavior. We're all here to enjoy the game together.",
    "intro": "We use a three-strike system to keep things fair.",
    "levels": [
      {
        "heading": "Strike 1: Warning",
        "body": "A staff member will reach out to discuss what happened."
      },
      {
        "heading": "Strike 2: 24-hour mute",
        "body": "This is your final warning."
      },
      {
        "heading": "Strike 3: Ban",
        "body": "Removal from the server and the in-game clan."
      },
      {
        "heading": "Immediate ban (no strikes):",
        "body": "Hate speech, doxxing, or scamming will result in an immediate permanent ban."
      },
      {
        "heading": "Appeals",
        "body": "We believe in second chances. If you feel a strike or ban was unfair, please open a ticket in <#1558399103757717518>.\n\u26e7 Staff will review every appeal carefully.\n\u26e7 A successful appeal means a fresh start, though previous strikes will remain on record.\n\u26e7 If issues continue after a successful appeal, the ban will be permanent."
      }
    ],
    "title": "\u26e7 Strike System \u26e7"
  },
