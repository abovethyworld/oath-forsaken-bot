# Copy this file to ".env" and fill in your values.
# NEVER share your token or commit .env anywhere public.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=PASTE_BOT_TOKEN_HERE

# Application ID from https://discord.com/developers/applications -> your app -> General Information
CLIENT_ID=PASTE_APPLICATION_ID_HERE

# Google Calendar sync (optional — see "Google Calendar" in README)
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_API_KEY=
GCAL_CALENDAR_ID=
# Message IDs and image URLs for the auto-updating event calendar embed
GCAL_THUMBNAIL_MSG_ID=
GCAL_THUMBNAIL_URL=
GCAL_BANNER_MSG_ID=
GCAL_BANNER_URL=

# Wise Old Man API key (optional — raises rate limit from 20 to 100 req/min)
WOM_API_KEY=
